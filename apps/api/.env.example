# =============================================================================
# Momoki API - Laravel 環境変数
# =============================================================================
# コピー方法:
#   PowerShell: Copy-Item apps\api\.env.example apps\api\.env
#   Git Bash:   cp apps/api/.env.example apps/api/.env
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=Momoki
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# フロントエンドURL（CORS/リダイレクト用）
FRONTEND_URL=http://localhost:3000

# 本番
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://yourapi.up.railway.app
# FRONTEND_URL=https://yourapp.vercel.app

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=momoki
DB_USERNAME=momoki
DB_PASSWORD=secret

# 本番 (Supabase) - DATABASE_URL があれば上記より優先される
# DATABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# Session & Cookie
# -----------------------------------------------------------------------------
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# 本番（クロスドメインCookie必須）
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=none

# -----------------------------------------------------------------------------
# Sanctum (SPA Authentication)
# -----------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# 本番（Vercelドメイン）
# SANCTUM_STATEFUL_DOMAINS=yourapp.vercel.app

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000

# 本番
# CORS_ALLOWED_ORIGINS=https://yourapp.vercel.app

# -----------------------------------------------------------------------------
# LINE Login
# -----------------------------------------------------------------------------
# LINE Developers Console から取得
# https://developers.line.biz/console/
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
LINE_REDIRECT_URI=http://localhost:3000/auth/line/callback

# 本番
# LINE_REDIRECT_URI=https://yourapp.vercel.app/auth/line/callback

# -----------------------------------------------------------------------------
# Admin（招待コード方式）
# -----------------------------------------------------------------------------
ADMIN_INVITE_CODE=changeme

# -----------------------------------------------------------------------------
# Store（デフォルト店舗）
# -----------------------------------------------------------------------------
DEFAULT_STORE_ID=1

# -----------------------------------------------------------------------------
# Business Day（営業日）
# -----------------------------------------------------------------------------
# 営業開始時刻（HH:MM）。この時刻〜翌日の同時刻-1秒が1営業日
BUSINESS_DAY_START=21:00

CACHE_STORE=file

CACHE_DRIVER=file