# =============================================================================
# Momoki Web - Next.js 環境変数
# =============================================================================
# コピー方法:
#   PowerShell: Copy-Item apps\web\.env.example apps\web\.env.local
#   Git Bash:   cp apps/web/.env.example apps/web/.env.local
# =============================================================================

# -----------------------------------------------------------------------------
# API接続
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# 本番 (Railway)
# NEXT_PUBLIC_API_URL=https://yourapi.up.railway.app

# -----------------------------------------------------------------------------
# LINE Login (PKCE)
# -----------------------------------------------------------------------------
# LINE Developers Console から取得
# https://developers.line.biz/console/
NEXT_PUBLIC_LINE_CLIENT_ID=

# コールバックURL（LINE Developersにも同じURLを登録）
NEXT_PUBLIC_LINE_REDIRECT_URI=http://localhost:3000/auth/line/callback

# 本番 (Vercel)
# NEXT_PUBLIC_LINE_REDIRECT_URI=https://yourapp.vercel.app/auth/line/callback

# -----------------------------------------------------------------------------
# Admin
# -----------------------------------------------------------------------------
# 管理者セットアップ機能の表示制御（本番で無効にする場合 false）
NEXT_PUBLIC_ADMIN_SETUP_ENABLED=true
